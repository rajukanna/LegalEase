# ==============================================================================
# LegalEase Root Environment Configuration (.env.example)
# Copy this file to .env and configure your secrets.
# NEVER commit .env to version control.
# ==============================================================================

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=gemini  # gemini | anthropic | openai | mock

# Vector Database & Embeddings
VECTOR_DB_URL=local_chroma_db
EMBEDDING_PROVIDER=gemini  # gemini | local

# Database & Object Storage
DATABASE_URL=sqlite:///./data/legalease.db
GCS_BUCKET=your_gcs_bucket_name_here
UPLOAD_DIR=./data/uploads

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting & Safety
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=30
